# Local development uses a SQLite file. For production use Postgres, e.g.
# PW_DATABASE_URL=postgresql+psycopg://pocketwatcher:pocketwatcher@localhost:5432/pocketwatcher
PW_DATABASE_URL=sqlite:///pocketwatcher.db
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PW_FERNET_KEY=
